{
  "$schema": "../node_modules/@tauri-apps/cli/config.schema.json",
  "productName": "VoxStudio",
  "version": "../package.json",
  "identifier": "com.voxstudio.app",
  "build": {
    "frontendDist": "../dist",
    "devUrl": "http://localhost:1420",
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "npm run build"
  },
  "app": {
    "macOSPrivateApi": true,
    "windows": [
      {
        "label": "main",
        "title": "VoxStudio",
        "width": 1280,
        "height": 820,
        "minWidth": 900,
        "minHeight": 600,
        "center": true,
        "transparent": true,
        "titleBarStyle": "Overlay",
        "hiddenTitle": true,
        "dragDropEnabled": false,
        "trafficLightPosition": {
          "x": 18,
          "y": 22
        },
        "windowEffects": {
          "effects": [
            "sidebar",
            "mica"
          ],
          "state": "followsWindowActiveState"
        }
      }
    ],
    "security": {
      "csp": "default-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' blob: data: http://127.0.0.1:*; media-src 'self' blob: data: http://127.0.0.1:*; connect-src 'self' ipc: http://ipc.localhost http://127.0.0.1:* ws://127.0.0.1:*"
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "category": "Productivity",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "macOS": {
      "minimumSystemVersion": "13.3",
      "entitlements": "Entitlements.plist"
    },
    "shortDescription": "Private AI voice studio",
    "longDescription": "Clone, design and direct voices, dub videos, narrate books and transcribe speech — entirely on your computer.",
    "copyright": "© 2026 VoxStudio contributors",
    "publisher": "VoxStudio"
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDA4MjRGRkZEQTc5OTIzOUIKUldTYkk1bW4vZjhrQ05mVUwwNkxvMFFZNDl2Zms2SG9ZUWdRWHp5N2JQK3hSa2RxQVp4eDEvZnMK",
      "endpoints": [
        "https://vox-studio.devops-monk.com/updates/latest.json"
      ]
    },
    "deep-link": {
      "desktop": {
        "schemes": [
          "voxstudio"
        ]
      }
    }
  }
}
